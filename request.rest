### Create Menu - Admin Only
POST {{baseUrl}}/menus
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="category_id"

{{categoryId}}
--Boundary
Content-Disposition: form-data; name="name"

Nasi Ayam Geprek
--Boundary
Content-Disposition: form-data; name="price"

11000
--Boundary
Content-Disposition: form-data; name="stock"

30
--Boundary
Content-Disposition: form-data; name="is_available"

true
--Boundary
Content-Disposition: form-data; name="image"; filename="nasi-ayam-geprek.jpg"
Content-Type: image/jpeg

< ./sample-images/nasi-ayam-geprek.jpg
--Boundary--

> {%
client.global.set("menuId", response.body.data.id);
%}

